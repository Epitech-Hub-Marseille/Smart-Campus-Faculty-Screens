{
  "name": "@smartcampus/faculty-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edge agent of a Faculty screen: holds the device key and the WSS link, keeps verified content on disk, and serves the kiosk page on localhost",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartcampus/faculty-local": "workspace:*",
    "@smartcampus/handshake": "file:../../vendor/smartcampus-handshake-0.1.0.tgz",
    "@smartcampus/protocol": "file:../../vendor/smartcampus-protocol-0.1.0.tgz",
    "express": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
