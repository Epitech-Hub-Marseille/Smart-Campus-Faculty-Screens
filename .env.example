# Address of the central server (the console and the API, same host). The device channel is derived from it:
# http becomes ws, https becomes wss.
SERVER_URL=http://host.docker.internal:3000

# The server's PUBLIC key (base64 SPKI), provisioned on this device: the QR code of the console (Devices, Provision a
# device) or `curl $SERVER_URL/api/server-key`, confirmed against the fingerprint shown in the console. The agent
# never learns it from the network by itself: a relay could hand it its own.
SERVER_PUBLIC_KEY=

# Only for a server with a self-signed certificate: the SHA-256 of that certificate. Without it, certificates are
# verified normally. Identity does not rest on TLS either way (the handshake proves it).
SERVER_TLS_FINGERPRINT=

# Name shown to the administrator in the connection request.
DEVICE_NAME=Faculty screen

# Port of the local page on this machine (the kiosk opens http://localhost:<port>).
DISPLAY_PORT=3000

# Development only: extra origins allowed to open the local socket, e.g. the Vite dev server.
DISPLAY_ALLOWED_ORIGINS=

LOG_LEVEL=info
